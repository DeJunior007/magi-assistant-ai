[Desktop Entry]
Type=Application
Name=Gravar voz da Condessa
GenericName=Gravador do wake word
Comment=Grava as amostras da palavra de ativação "Condessa" (segure Espaço para gravar)
Exec=@HOME@/.local/bin/uv run --project @REPO@ python -m tools.wakeword.record_gui
Path=@REPO@
Icon=audio-input-microphone
Terminal=false
Keywords=magi;magui;condessa;wake word;gravar;microfone;voz;
Categories=AudioVideo;Audio;Recorder;
StartupNotify=true
