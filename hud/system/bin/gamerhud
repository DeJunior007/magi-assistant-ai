#!/usr/bin/env bash
# Liga/desliga o GamerHUD no monitor secundário.
HUD="$HOME/.local/share/gamerhud/gamerhud.py"
STATE="$HOME/.cache/gamerhud/wallpaper_state.json"
PATTERN='^python3 .*/gamerhud\.py$'
if pkill -f "$PATTERN"; then
    for _ in $(seq 30); do pgrep -f "$PATTERN" >/dev/null || break; sleep 0.1; done
    # se o HUD não conseguiu restaurar o Wallpaper Engine sozinho, restaura aqui
    [ -f "$STATE" ] && python3 "$HUD" --restore
    exit 0
fi
exec nohup python3 "$HUD" >/dev/null 2>&1 &
