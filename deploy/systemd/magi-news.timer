# Dispara magi-news.service a cada 2 h enquanto o PC estiver ligado (R18.1). Persistent=true
# roda logo ao ligar se a última janela passou com o PC desligado.
[Unit]
Description=Magui: coleta de notícias a cada 2 h

[Timer]
OnCalendar=*-*-* 00/2:00:00
Persistent=true
RandomizedDelaySec=2min
Unit=magi-news.service

[Install]
WantedBy=timers.target
