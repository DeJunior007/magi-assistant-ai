# Uma execução do coletor de notícias (design §8). Unit de usuário, disparada por magi-news.timer.
# Template: @REPO@ é trocado pelo caminho real do repositório por hud/install.sh, que instala esta
# unit e o timer em ~/.config/systemd/user/. Rode o install.sh de novo se mover o repositório.
[Unit]
Description=Magui: coleta de notícias (magi-news)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO@
ExecStart="@REPO@/.venv/bin/magi-news"
# A coleta tem teto de 50 s; isto só segura travas inesperadas.
TimeoutStartSec=120
Nice=10
IOSchedulingClass=idle
