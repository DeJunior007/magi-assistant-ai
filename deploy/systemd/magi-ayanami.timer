# Acorda a Ayanami (magi-ayanami.service) a cada 2 h enquanto o PC estiver ligado (R18.1).
# Persistent=true roda logo ao ligar se a última janela passou com o PC desligado.
[Unit]
Description=Ayanami: coleta de notícias a cada 2 h

[Timer]
OnCalendar=*-*-* 00/2:00:00
Persistent=true
RandomizedDelaySec=2min
Unit=magi-ayanami.service

[Install]
WantedBy=timers.target
