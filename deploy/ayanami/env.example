# Segredos da Ayanami (spec §9.1). Copie para /opt/ayanami/.env (chmod 0600, fora do git).
# Só nomes e valores FALSOS aqui. Faltando obrigatória da fase ligada: a API sobe degradada e
# /saude mostra ok=false com "faltando" (só nomes).

# sempre
POSTGRES_PASSWORD=troque-me
GEMINI_API_KEY=falso-gemini
TELEGRAM_BOT_TOKEN=000000:falso
TELEGRAM_CHAT_ID=0

# modo nuvem com LLM ([nuvem] ligado e [budget] teto_nuvem_usd > 0); chave dedicada com limite no painel
OPENAI_API_KEY=falso-openai

# Web Push (gerar com: ayanami push chaves)
VAPID_PUBLIC_KEY=falso-publica
VAPID_PRIVATE_KEY=falso-privada
VAPID_SUB=mailto:alguem@exemplo.com

# backups ([backup] ligado); chave B2 restrita ao bucket
B2_ACCOUNT_ID=falso-id
B2_ACCOUNT_KEY=falso-chave
B2_BUCKET=falso-bucket
RESTIC_PASSWORD=troque-me
