<?xml version="1.0" encoding="utf-8"?>
<!-- Só HTTPS (spec §8.1): a Ayanami é *.ts.net com certificado do Tailscale. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
