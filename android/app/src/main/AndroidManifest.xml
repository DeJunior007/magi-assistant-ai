<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- R10.5: exatamente estas (CA-M2). RECEIVE_BOOT_COMPLETED só com o R2.4 (L). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- O WorkManager traz esta; o MVP não reage ao boot. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regras_extracao"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_condessa"
        android:roundIcon="@mipmap/ic_condessa"
        android:label="@string/nome_app"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Tema.Condessa"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Botão de voz do fone (D12a): abre já ouvindo. -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Media3 (A3.3): botão BT e reprodução da fala. -->
        <service
            android:name="br.com.dekasis.condessa.voz.android.SessaoMidia"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- UnifiedPush (A6.1): eventos do distribuidor ntfy. -->
        <service
            android:name=".push.ReceptorPush"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- Escuta com app fechado (L, R2.4): desligada no MVP. -->
        <service
            android:name=".escuta.EscutaService"
            android:enabled="false"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
